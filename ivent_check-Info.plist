<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>現在地の周辺で開催されるイベントを探すために使用します。位置情報は約1km単位に丸めて検索に利用し、履歴として保存しません。</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>「移動先でも検知」をオンにした場合に限り、大幅な位置の変化を検知して移動先のイベントを通知するために使用します。常時GPSは使用しません。</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>選択したイベントをカレンダーに登録するために使用します。</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
	</array>
	<key>EventFeedURL</key>
	<string></string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).refresh</string>
	</array>
</dict>
</plist>
